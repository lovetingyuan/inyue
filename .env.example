# Sentry DSNs for the Nuxt web client, Capacitor Android, and Cloudflare Worker.
NUXT_PUBLIC_SENTRY_WEB_DSN=
NUXT_PUBLIC_SENTRY_ANDROID_DSN=
NUXT_SENTRY_SERVER_DSN=

# npm run deploy uses the authenticated Sentry CLI to upload web and Worker source maps.
# Set INYUE_SENTRY_SOURCEMAPS=1 in the shell for npm run build:android to upload WebView maps.
